<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Template plist. install-daily-launch-agent.sh substitutes:
        @CCDIARY_BIN@   →  absolute path to the *installed* ccdiary-cli (outside ~/Documents;
                           see install-daily-launch-agent.sh for the Documents-TCC rationale)
        @LOG_DIR@       →  absolute path to ~/Library/Logs/CCDiary
    Do not commit the rendered version with absolute paths.

    Runs on every Mac in the fleet to push local activity stats to the cloud.
    The primary Mac runs a separate daily-generate agent that fetches and
    merges stats from all hosts before generating the diary.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>sh.saqoo.CCDiary.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>@CCDIARY_BIN@</string>
        <string>push-stats</string>
        <string>--yesterday</string>
        <string>--source-timeout</string>
        <string>120</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>CCDIARY_HOST_NAME</key>
        <string>@HOST_NAME@</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>@LOG_DIR@/daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/daily.err.log</string>
</dict>
</plist>
